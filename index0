    // ── Correção definitiva de transparência: a foto do usuário passa a ser
    //    pintada num <canvas> que fica no topo da pilha de camadas daquele
    //    "quadrante" (photo-frame), isolado (isolation:isolate) do resto da
    //    UI. O canvas recebe um preenchimento 100% opaco ANTES de desenhar a
    //    foto por cima — como é pintura de pixels (drawImage), não leitura
    //    (getImageData/toDataURL), não depende de CORS do servidor da foto.
    //    Isso resolve o vazamento visual do fundo animado (#neon-canvas /
    //    #bg-layer) por trás da foto, que é o bug real — o canvas passa a
    //    ser a camada mais alta daquele quadrante, e nada abaixo dele pode
    //    aparecer através. ──
    function _paintPhotoCanvas(imgEl){
        var canvas=document.getElementById('logo-photo-canvas');
        if(!canvas)return;
        var dpr=window.devicePixelRatio||1;
        var size=90;
        canvas.width=size*dpr;
        canvas.height=size*dpr;
        var ctx=canvas.getContext('2d');
        ctx.setTransform(dpr,0,0,dpr,0,0);
        ctx.clearRect(0,0,size,size);
        // fundo 100% opaco — nenhuma transparência sobrevive a partir daqui
        ctx.fillStyle='#000';
        ctx.fillRect(0,0,size,size);
        // reproduz manualmente o object-fit:cover que a <img> usava
        var iw=imgEl.naturalWidth||size, ih=imgEl.naturalHeight||size;
        var scale=Math.max(size/iw, size/ih);
        var dw=iw*scale, dh=ih*scale;
        var dx=(size-dw)/2, dy=(size-dh)/2;
        try{
            ctx.drawImage(imgEl,dx,dy,dw,dh);
            canvas.classList.add('active');
        }catch(e){
            // se por algum motivo o drawImage falhar, mantém a <img> visível
            // (fallback antigo com fundo preto no .photo-frame) em vez de
            // deixar o quadrante vazio
            console.log('[NETSIMON] paintPhotoCanvas falhou: '+e);
            canvas.classList.remove('active');
        }
    }
    function applyUserPhoto(photoUrl){
        console.log('[NETSIMON] applyUserPhoto chamado: '+photoUrl);
        var img=document.getElementById('logo-img');if(!img){console.log('[NETSIMON] logo-img nao encontrado');return;}
        if(!photoUrl||!photoUrl.startsWith('http')){console.log('[NETSIMON] URL invalida: '+photoUrl);return;}
        _pendingPhotoUrl=photoUrl;
        _photoRetryCount=0;
        _tryLoadPhoto();
    }
    function _tryLoadPhoto(){
        var img=document.getElementById('logo-img');
        if(!img||!_pendingPhotoUrl)return;
        if(img.getAttribute('data-photo')===_pendingPhotoUrl&&img.complete&&img.naturalWidth>0){
            // já carregada com sucesso
            return;
        }
        img.style.opacity='0';
        var url=_pendingPhotoUrl;
        // força cache-bust no retry pra evitar imagem corrompida em cache
        var loadUrl=(_photoRetryCount>0)?(url+(url.indexOf('?')>=0?'&':'?')+'_r='+_photoRetryCount):url;
        setTimeout(function(){
            if(_pendingPhotoUrl!==url)return; // foto mudou enquanto esperava
            var tmp=new Image();
            tmp.onload=function(){
                console.log('[NETSIMON] foto carregada com sucesso: '+url);
                _photoRetryCount=0;
                var img2=document.getElementById('logo-img');if(!img2)return;
                img2.src=url;
                img2.classList.add('user-photo');
                img2.setAttribute('data-photo',url);
                img2.style.opacity='1';
                var wrap2=document.querySelector('.logo-wrap');
                if(wrap2)wrap2.classList.add('has-ring');
                // pinta a foto no canvas opaco (camada mais alta do quadrante)
                _paintPhotoCanvas(tmp);
            };
            tmp.onerror=function(){
                console.log('[NETSIMON] foto FALHOU carregar (tentativa '+_photoRetryCount+'): '+loadUrl);
                _photoRetryCount++;
                if(_photoRetryCount<=4){
                    // retry exponencial: 1s, 2s, 4s, 8s
                    _photoRetryTimer=setTimeout(_tryLoadPhoto, Math.pow(2,_photoRetryCount-1)*1000);
                } else {
                    // desiste após 4 tentativas — mantém logo
                    _pendingPhotoUrl=null;
                    var img2=document.getElementById('logo-img');if(img2){img2.style.opacity='1';}
                }
            };
            tmp.src=loadUrl;
        },250);
    }
