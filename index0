function getDeviceIdentifier() {
    if (window.Android && Android.getDeviceHash) {
        return Android.getDeviceHash();
    }
    var stored = storageGet('_device_id');
    if (!stored) {
        stored = Math.random().toString(36).substring(2) + Date.now().toString(36);
        storageSave('_device_id', stored);
    }
    return stored;
}

// Callback chamado pelo Kotlin após performDeviceCheck
window._deviceCheckCallback = null;
window._deviceCheckTimeout = null;
window.onDeviceCheckResult = function(status, message, limit) {
    var cb = window._deviceCheckCallback;
    window._deviceCheckCallback = null;
    if (window._deviceCheckTimeout) { clearTimeout(window._deviceCheckTimeout); window._deviceCheckTimeout = null; }

    // BLOQUEIO sempre é exibido, mesmo que o callback já tenha se perdido
    // (WebView recarregou, Activity recriada, clique duplo, etc). Antes disso
    // o "if (!cb) return;" fazia o popup nunca aparecer nesses casos.
    if (status === 'blocked') {
        showDeviceBlocked(message || 'Acesso bloqueado.', limit || 1);
        return;
    }
    if (!cb) return;
    cb();
};

function checkDeviceAccess(username, onAllowed) {
    var deviceHash = getDeviceIdentifier();
    var phone = (window.Android && Android.getPhoneNumber) ? Android.getPhoneNumber() : '';

    if (window.Android && Android.performDeviceCheck) {
        // Usa o método nativo (OkHttp — sem restrição HTTP do WebView)
        window._deviceCheckCallback = onAllowed;

        // Timeout de segurança: se o nativo nunca responder (WebView
        // recarregada, Activity recriada, etc), não deixa a UI travada
        // em "VERIFICANDO..." para sempre.
        if (window._deviceCheckTimeout) clearTimeout(window._deviceCheckTimeout);
        window._deviceCheckTimeout = setTimeout(function () {
            window._deviceCheckTimeout = null;
            if (window._deviceCheckCallback) {
                window._deviceCheckCallback = null;
                showDeviceBlocked('Tempo esgotado ao verificar o dispositivo. Tente novamente.', 1);
            }
        }, 10000);

        Android.performDeviceCheck(username, deviceHash, phone);
    } else {
        // Fallback para ambiente sem Android (testes no browser)
        onAllowed();
    }
}

