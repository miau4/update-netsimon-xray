    // =============================================================================
    // DETECÇÃO AUTOMÁTICA DE OPERADORA (SIM/APN)
    // =============================================================================
    // Usa Android.getCarrierName() (TelephonyManager: simOperatorName / rede)
    // pra descobrir a operadora do chip e pré-selecionar a categoria certa,
    // evitando que o cliente tente conectar numa operadora incompatível com o
    // chip dele. As outras categorias continuam acessíveis manualmente pela
    // aba "Todos" no seletor de operadoras — nada é escondido, só o padrão
    // muda. Só entra em ação se o cliente ainda não tiver escolhido uma
    // operadora manualmente antes (nada de sobrescrever escolha salva).
    function matchCarrierCategory(carrierName, ops) {
        if (!carrierName) return null;
        var norm = carrierName.toUpperCase();
        var cats = [], seen = {};
        ops.forEach(function (o) {
            var c = o.category && o.category.name ? o.category.name : null;
            if (c && !seen[c]) { seen[c] = true; cats.push(c); }
        });
        for (var i = 0; i < cats.length; i++) {
            if (norm.indexOf(cats[i].toUpperCase()) !== -1) return cats[i];
        }
        return null;
    }
    function renderOperators(ops,selName){
        var cats=[],seen={};ops.forEach(function(o){var c=o.category&&o.category.name?o.category.name:'Geral';if(!seen[c]){seen[c]=true;cats.push(c);}});
        var tabsEl=document.getElementById('cat-tabs');tabsEl.innerHTML='';
        if(cats.length>1){['Todos'].concat(cats).forEach(function(c){var t=document.createElement('button');t.className='cat-tab'+(currentCategory===c||(!currentCategory&&c==='Todos')?' active':'');t.textContent=c;t.onclick=function(){currentCategory=c==='Todos'?null:c;renderOps(ops,selName);updateCatTabs();};tabsEl.appendChild(t);});}
        renderOps(ops,selName);
    }
