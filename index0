// CONEXÃO AUTOMÁTICA (botão LIGAR)
// =============================================================================
// Reaproveita a MESMA lógica do diagnóstico (testar, em sequência, as opções
// da mesma operadora/categoria até uma gerar dados reais — Android.diagProbe),
// mas de forma SILENCIOSA: sem o popup de diagnóstico, sem log na tela. O
// status continua mostrando "CONECTANDO..." o tempo todo. O popup só aparece
// se TODAS as opções falharem, com o resultado já pronto.
//
// Vale apenas para a conexão MANUAL (botão LIGAR). Reconexões automáticas
// (watchdog / queda de rede) continuam usando só a operadora já selecionada,
// sem essa varredura — ver TunnelWatchdog / reconnectJob, que não chamam
// startAutoConnect.
window._autoConnScanning = false;
window._autoConnLastError = null;
var _autoConnAborted = false;

function startAutoConnect(op) {
    if (!op || window._autoConnScanning) return;
    var sameCategory = allOperators.filter(function (o) {
        return o.category && op.category && o.category.name === op.category.name;
    });
    if (sameCategory.length === 0) sameCategory = [op];

    window._autoConnScanning = true;
    window._autoConnLastError = null;
    _autoConnAborted = false;
    _autoTryOption(sameCategory, 0, op);
}

function abortAutoConnect() {
    _autoConnAborted = true;
    window._autoConnScanning = false;
}

function _autoTryOption(options, idx, originalOp) {
    if (_autoConnAborted) return;

    if (idx >= options.length) {
        // Nenhuma opção gerou dados reais — encerra a varredura, devolve o
        // botão ao estado normal (via onTunnelState, que volta a valer) e só
        // aí mostra o popup de diagnóstico, já com o resultado.
        window._autoConnScanning = false;
        if (window.Android) Android.stopTunnel();
        window.onTunnelState({ running: false, error: null });

        _openDiagPopup();

        // CORREÇÃO: se o motivo real de TODAS as falhas foi credencial
        // inválida/expirada (guardado em _autoConnLastError, ver
        // window.onTunnelState acima), o usuário precisa saber disso —
        // mostrar "SEM CONEXÃO" genérico aqui só geraria suporte
        // desnecessário, já que o problema não é sinal/rede, é a senha.
        if (window._autoConnLastError === 'ssh_auth_failed') {
            _diagLog('❌ Erro de autenticação — credenciais inválidas ou usuário expirado.', 'err');
            var safeOpName = originalOp.name.replace(/'/g, "\\'");
            _diagShowResult('🔑', 'ERRO DE AUTENTICAÇÃO',
                'Suas credenciais SSH foram recusadas em todas as opções testadas. Verifique se o usuário e a senha estão corretos, ou se o acesso expirou.',
                '<button onclick="closeDiagPopup();window.requestSshCredentials(\'' + safeOpName + '\', true);" ' +
                'style="width:100%;background:#f39c12;color:#1a1200;border:none;border-radius:8px;padding:11px 20px;font-size:.8rem;font-weight:700;cursor:pointer;margin-bottom:8px">🔑 CORRIGIR CREDENCIAIS</button>' +
                _wppBtn());
            return;
        }

        _diagLog('❌ Nenhuma opção gerou conexão.', 'err');
        var catLabel = (originalOp.category && originalOp.category.name) ? originalOp.category.name : originalOp.name;

        // Instrução extra (em vermelho) SÓ para a operadora Vivo: o app não
        // tem permissão de administrador de sistema pra alternar o modo avião
        // sozinho (exige WRITE_SECURE_SETTINGS/device-admin, indisponível em
        // aparelho comum de cliente), então pedimos pro próprio cliente
        // ativar e desativar o modo avião manualmente e tentar de novo.
        var isVivo = catLabel && catLabel.toUpperCase().indexOf('VIVO') !== -1;
        var vivoHint = isVivo
            ? '<div style="color:#ff3333;font-weight:700;font-size:.75rem;line-height:1.5;margin-bottom:10px;padding:10px;border:1px solid #ff3333;border-radius:8px;background:rgba(255,0,0,.08)">'
              + '⚠️ ATIVE o MODO AVIÃO por alguns segundos e depois DESATIVE. Isso costuma trocar o IP da operadora Vivo. Depois, toque em LIGAR novamente.'
              + '</div>'
            : '';

        _diagShowResult('⚠️', 'SEM CONEXÃO',
            'Não foi possível estabelecer conexão em nenhuma opção disponível para ' + catLabel + '. Verifique o sinal ou entre em contato com o suporte.',
            vivoHint + _wppBtn());
        return;
    }

    var op = options[idx];
    var sshUser = storageGet('ssh_username') || '';
    var sshPass = storageGet('ssh_password') || '';
    var uuid    = document.getElementById('user-uuid') ? document.getElementById('user-uuid').value.trim() : '';
    var isSsh   = op.mode === 'SSH_DIRECT' || op.mode === 'SSL_PROXY';

    if (window.Android) Android.stopTunnel();
    if (window.Android && Android.selectOperator) Android.selectOperator(op.name);

    setTimeout(function () {
        if (_autoConnAborted) return;
        if (window.Android) {
            if (isSsh) Android.startSshWithCredentials(op.name, sshUser, sshPass);
            else       Android.startTunnelWithCreds(uuid, sshUser, sshPass);
        }

        setTimeout(function () {
            if (_autoConnAborted) return;
            var probeOk = (window.Android && Android.diagProbe) ? Android.diagProbe() : false;

            if (probeOk) {
                window._autoConnScanning = false;
                selectedOpName = op.name;
                storageSave('netsmon_operator', op.name);
                var lbl = document.getElementById('op-selected-label'); if (lbl) lbl.textContent = op.name;
                var img = document.getElementById('op-circle-img'); if (img && op.icon) img.src = op.icon;
                // Reaplica o estado "conectado" normal na UI (botão PARAR, timer,
                // etc.) — o resultado real do ping já é tratado à parte pela
                // rotina nativa startPingAfterConnect (a cada 10s até responder).
                window.onTunnelState({ running: true, error: null });
                if (window.Android && Android.measurePingNow) Android.measurePingNow();
            } else {
                if (window.Android) Android.stopTunnel();
                setTimeout(function () { _autoTryOption(options, idx + 1, originalOp); }, 800);
            }
        }, 8000);
    }, 1500);
}

