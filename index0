<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <title>NETSIMON</title>
    <style>
        * { margin:0; padding:0; box-sizing:border-box; font-family:'Segoe UI',sans-serif; }
        html, body { height:100%; overflow:hidden; background:#000; color:#fff; }
        :root {
            --purple: #6F00FF;
            --blue:   #001F3F;
            --glow:   #007BFF;
            --green:  #2ecc71;
            --red:    #e74c3c;
        }

        #neon-canvas { position:fixed; inset:0; z-index:1; pointer-events:none; }
        #bg-layer {
            position:fixed; inset:0; z-index:2;
            background-size:cover; background-position:center; background-repeat:no-repeat;
            opacity:0; pointer-events:none; transition:opacity 0.8s ease;
        }
        #bg-layer.loaded { opacity:0.30; }
        body { display:flex; flex-direction:column; align-items:center; position:relative; z-index:3; }

        @keyframes colorBreeze {
            0%   { background-position:0% 50%; }
            50%  { background-position:100% 50%; }
            100% { background-position:0% 50%; }
        }
        @keyframes fadeIn  { from{opacity:0} to{opacity:1} }
        @keyframes twinkle {
            0%,100% { opacity:1; filter:brightness(1) drop-shadow(0 0 6px #007BFF); }
            40%     { opacity:.6; filter:brightness(.7) drop-shadow(0 0 2px #007BFF); }
            70%     { opacity:.9; filter:brightness(1.2) drop-shadow(0 0 12px #6F00FF); }
        }
        @keyframes pulseBlue  { 0%,100%{box-shadow:0 0 28px rgba(0,123,255,.6);} 50%{box-shadow:0 0 50px rgba(0,123,255,.95);} }
        @keyframes pulseGreen { 0%,100%{box-shadow:0 0 28px rgba(46,204,113,.6);} 50%{box-shadow:0 0 50px rgba(46,204,113,.95);} }
        @keyframes slideUp { from{transform:translateY(100%);opacity:0;} to{transform:translateY(0);opacity:1;} }
        @keyframes popIn   { from{transform:translate(-50%,-50%) scale(.85);opacity:0;} to{transform:translate(-50%,-50%) scale(1);opacity:1;} }
        @keyframes spin    { to{transform:rotate(360deg);} }
        @keyframes orbitRocket {
            0%   { transform: rotate(0deg)   translateX(58px) rotate(0deg); }
            100% { transform: rotate(360deg) translateX(58px) rotate(-360deg); }
        }
        @keyframes pulseRed { 0%,100%{opacity:1;} 50%{opacity:.5;} }
        @keyframes shareGlow { 0%,100%{box-shadow:0 0 10px rgba(46,204,113,.5),0 0 0 0 rgba(46,204,113,.3);} 50%{box-shadow:0 0 18px rgba(46,204,113,.8),0 0 0 4px rgba(46,204,113,.1);} }

        #update-toast {
            position:fixed; bottom:28px; left:50%; transform:translateX(-50%);
            background:rgba(15,15,15,.95); border:1px solid #2ecc71; color:#2ecc71;
            font-size:.72rem; font-weight:700; letter-spacing:1.5px; text-transform:uppercase;
            padding:8px 22px; border-radius:30px; white-space:nowrap; pointer-events:none;
            z-index:9999; opacity:0; box-shadow:0 0 14px rgba(46,204,113,.3); transition:opacity .45s ease;
        }
        #update-toast.show { opacity:1; }

        header { padding:18px 0 6px 0; flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:2px; }
        .logo-wrap {
            position:relative; display:inline-block; cursor:pointer;
            /* Todo o quadrante do logo/foto vira sua própria camada de
               composição, travada acima do fundo animado (#neon-canvas /
               #bg-layer) — nada de fora vaza pra dentro nem o contrário. */
            isolation:isolate;
            z-index:5;
        }
        .logo-wrap img {
            width:140px; display:block;
            animation:twinkle 3.5s ease-in-out infinite;
            filter:drop-shadow(0 0 18px rgba(0,123,255,.7));
            transition:opacity .45s ease, border-radius .45s ease, filter .45s ease;
        }
        .photo-frame {
            display:inline-block; line-height:0; position:relative;
            /* Cria um contexto de composição próprio: nenhum blend/efeito
               de camadas fora deste quadrante pode se misturar com o que
               está dentro dele, e vice-versa. */
            isolation:isolate;
        }
        #logo-photo-canvas {
            display:none;
            position:absolute; top:0; left:0;
            width:90px; height:90px;
            border-radius:50%;
            background:#000;
            /* Camada mais alta do quadrante: cobre a <img> por completo. */
            z-index:2;
        }
        .logo-wrap.has-ring #logo-photo-canvas.active { display:block; }
        .logo-wrap img.user-photo {
            width:90px; height:90px; border-radius:50%;
            object-fit:cover;
            /* Sobrescreve explicitamente animation/filter herdados de ".logo-wrap img":
               sem isso a oscilação "twinkle" continuaria valendo por herança de
               cascata mesmo com .user-photo aplicada. Moldura agora é o anel
               estático abaixo (.logo-wrap.has-ring::after). */
            animation:none;
            filter:none;
            /* Fundo redundante de segurança (não é a correção principal — ver
               .logo-wrap.has-ring .photo-frame abaixo, que é quem realmente
               garante a opacidade). */
            background:#000;
        }
        /* Correção real da transparência: background-color direto numa <img>
           com object-fit:cover nem sempre pinta atrás do canal alfa da foto
           em todas as versões do WebView Android (mesmo com o fundo definido
           na própria <img> acima). Um <div> pai comum, com overflow:hidden
           recortando o círculo e background sólido, sempre pinta corretamente
           atrás de qualquer conteúdo filho — inclusive PNG/WebP transparente.
           .has-ring só é adicionado quando a foto do usuário está ativa
           (ver applyUserPhoto no JS), então o logo padrão (sem foto) continua
           sem recorte/fundo, como antes. */
        .logo-wrap.has-ring .photo-frame {
            width:90px; height:90px;
            border-radius:50%;
            overflow:hidden;
            background:#000;
        }
        .logo-wrap::after {
            content:''; position:absolute; inset:-12px;
            background:radial-gradient(ellipse at center, rgba(0,123,255,.35) 0%, transparent 70%);
            pointer-events:none; animation:pulseBlue 3.5s ease-in-out infinite; border-radius:50%;
        }
        /* Anel dourado estático ao redor da foto do usuário — sem oscilação e sem
           transparência pulsante. Substitui completamente o glow padrão acima
           quando .has-ring está presente (maior especificidade sempre vence). */
        .logo-wrap.has-ring::after {
            content:'';
            position:absolute;
            inset:auto;
            top:50%; left:50%;
            /* Tamanho do anel amarrado ao RASTRO FIXO do foguetinho, não a um
               valor solto tentativa-e-erro. O foguetinho orbita com raio fixo
               de 58px (ver @keyframes orbitRocket: translateX(58px)) — esse
               raio não muda com a resolução da tela nem com a imagem do anel,
               então é a referência mais estável que existe no layout.

               --orbit-radius: o raio da órbita, em px (tem que bater com o
               translateX() do keyframe orbitRocket).

               --ring-band-frac: em que fração do raio do canvas do PNG fica o
               "meio" da faixa de chama visível (ponto médio entre o buraco
               interno e a borda externa da arte). Medido no avatar_ring.png
               atual (canvas 803x803, buraco ~72-84% do raio, chama externa
               ~90-93% do raio → meio ≈ 0.85). SE TROCAR A ARTE DO ANEL, é essa
               a única constante que precisa remedir — o resto da fórmula
               continua funcionando sozinho, incluindo em qualquer resolução,
               porque background-size:contain nunca distorce a imagem.

               Fórmula: tamanho do box = (raio da órbita × 2) ÷ fração da
               faixa. Isso faz a órbita do foguetinho passar exatamente pelo
               meio da chama, como se ele estivesse "correndo" em cima do anel.

               --ring-offset-x / --ring-offset-y: CORREÇÃO DE CENTRALIZAÇÃO.
               O "top:50%; left:50%; translate(-50%,-50%)" abaixo centraliza
               o CANVAS INTEIRO do PNG (803x803) em cima do centro da foto —
               isso é o centro geométrico da arte, não necessariamente o
               centro do buraco transparente por onde a foto aparece. Se o
               buraco não estiver perfeitamente no meio do canvas do PNG
               (comum em artes de chama/fogo, que são desenhadas com
               "peso" visual maior de um lado), o resultado é exatamente o
               que foi visto no print: anel meio deslocado, mais grosso de
               um lado, mais fino/cortado do outro.
               Esses dois offsets deslocam SÓ o anel (a foto e o photo-frame
               continuam travados no centro real do .logo-wrap, intocados),
               empurrando o canvas do PNG na direção oposta ao desvio do
               buraco, até o buraco coincidir com o centro da foto.
               Valor de partida abaixo estimado a partir do print enviado
               (buraco do anel ligeiramente para baixo e para a direita do
               centro da foto) — ajuste fino deve ser feito olhando o app
               rodando de verdade, pixel a pixel é a forma confiável de
               calibrar isso, não estimativa por cima de screenshot. */
            --orbit-radius:68px;
            --ring-band-frac:0.85;
            --ring-offset-x:-8px;
            --ring-offset-y:-18px;
            width:calc(var(--orbit-radius) * 2 / var(--ring-band-frac));
            height:calc(var(--orbit-radius) * 2 / var(--ring-band-frac));
            transform:translate(calc(-50% + var(--ring-offset-x)), calc(-50% + var(--ring-offset-y)));
            background-image:url('file:///android_asset/avatar_ring.png');
            background-size:contain;
            background-position:center;
            background-repeat:no-repeat;
            border-radius:0;
            animation:none;
            pointer-events:none;
        }
        .orbit-rocket {
            position:absolute; top:50%; left:50%;
            width:18px; height:18px;
            margin-top:-9px; margin-left:-9px;
            pointer-events:none; z-index:10;
            animation:orbitRocket 4s linear infinite;
            transform-origin:center center;
        }

        main { width:100%; max-width:450px; flex-grow:1; display:flex; flex-direction:column; padding:10px 14px; }
        section { display:none; width:100%; height:100%; flex-direction:column; align-items:center; justify-content:space-between; padding-bottom:68px; }
        section.active { display:flex; animation:fadeIn .4s; }

        .breeze-card {
            background:linear-gradient(135deg,var(--purple),#000,var(--blue),#000,var(--purple));
            background-size:300% 300%; animation:colorBreeze 8s linear infinite;
            border:1px solid var(--glow); box-shadow:0 0 12px rgba(0,123,255,.3);
            border-radius:10px; text-align:center;
        }
        .info-container { display:flex; gap:10px; width:100%; }
        .info-box { flex:1; padding:8px 10px; }
        .info-label { font-size:.58rem; color:#aaa; text-transform:uppercase; font-weight:bold; margin-bottom:2px; display:block; letter-spacing:1px; }
        .info-value { font-size:.85rem; font-family:monospace; font-weight:bold; }
        .carrier-value { font-size:.6rem; font-family:monospace; font-weight:bold; color:#4a9eff; margin-top:3px; letter-spacing:.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; display:block; }
        .carrier-value.warn { color:#f39c12; }

        .operator-btn { display:flex; flex-direction:column; align-items:center; gap:6px; cursor:pointer; margin:8px 0; background:none; border:none; color:#fff; }
        .operator-circle {
            width:56px; height:56px; border-radius:50%; background:#0a1628;
            display:flex; align-items:center; justify-content:center;
            border:2px solid var(--glow); box-shadow:0 0 14px rgba(0,123,255,.5);
            overflow:hidden; transition:box-shadow .2s;
        }
        .operator-circle:active { box-shadow:0 0 24px rgba(0,123,255,.9); }
        .operator-circle img { width:100%; height:100%; object-fit:cover; }
        .operator-name { font-size:.62rem; color:#aaa; text-transform:uppercase; letter-spacing:1px; }

        #btn-connection {
            width:155px; height:155px; border-radius:50%;
            border:4px solid var(--glow); color:#fff; font-size:1.25rem; font-weight:900; cursor:pointer;
            background:linear-gradient(135deg,var(--purple),#000,var(--blue),#000,var(--purple));
            background-size:300% 300%;
            animation:colorBreeze 5s linear infinite, pulseBlue 3s ease-in-out infinite;
            letter-spacing:2px; transition:border-color .3s;
        }
        #btn-connection.active { border-color:var(--green); animation:colorBreeze 5s linear infinite, pulseGreen 3s ease-in-out infinite; }
        #btn-connection.connecting { border-color:#f39c12; animation:colorBreeze 5s linear infinite; font-size:1rem; }

        .status-text { font-size:.95rem; font-weight:900; text-transform:uppercase; letter-spacing:1px;
            position:fixed; bottom:62px; left:0; right:0; text-align:center;
            height:22px; z-index:600; pointer-events:none; }
        .connected  { color:var(--green); text-shadow:0 0 10px var(--green); }
        .error-text { color:var(--red); }
        .warn-text  { color:#f39c12; }

        .uuid-box { width:100%; background:transparent; border:none; color:#fff; font-family:monospace; font-size:.92rem; text-align:center; font-weight:bold; outline:none; }
        .app-version { font-size:.55rem; color:#333; letter-spacing:2px; text-transform:uppercase; text-align:center; margin-top:5px; display:block; }

        #uuid-section { width:100%; transition:opacity .3s; }
        #uuid-section.hidden { display:none; }

        #user-info-card {
            display:none; width:100%;
            background:linear-gradient(135deg,rgba(0,40,80,.9),rgba(10,0,30,.9),rgba(0,40,80,.9));
            border:1px solid rgba(0,123,255,.4);
            border-radius:12px; padding:10px 12px 8px;
            animation:fadeIn .4s;
        }
        #user-info-card.show { display:block; }

        .cu-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; }
        .cu-title { font-size:.55rem; color:#4a9eff; text-transform:uppercase; letter-spacing:1.5px; font-weight:700; }
        .cu-refresh-btn {
            background:transparent; border:1px solid #1a3560; color:#2a5090;
            border-radius:50%; width:22px; height:22px; cursor:pointer;
            display:flex; align-items:center; justify-content:center; font-size:.7rem;
            transition:all .2s; padding:0; flex-shrink:0;
        }
        .cu-refresh-btn:active { border-color:var(--glow); color:var(--glow); }
        .cu-refresh-btn.spinning span { display:inline-block; animation:spin .7s linear infinite; }
        .cu-grid { display:grid; grid-template-columns:1fr 1fr; gap:6px; }
        .cu-item { background:rgba(0,0,0,.4); border-radius:8px; padding:7px 10px; display:flex; flex-direction:column; gap:2px; }
        .cu-item-label { font-size:.5rem; color:#3a6090; text-transform:uppercase; letter-spacing:1px; font-weight:700; }
        .cu-item-value { font-size:.78rem; font-family:monospace; font-weight:bold; color:#ccc; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .cu-item-value.good  { color:#2ecc71; }
        .cu-item-value.warn  { color:#f39c12; }
        .cu-item-value.bad   { color:#e74c3c; animation:pulseRed 1.2s ease-in-out infinite; }
        .cu-loading { display:flex; align-items:center; justify-content:center; gap:8px; padding:6px 0; font-size:.65rem; color:#2a5090; letter-spacing:1px; }
        .cu-spin { width:12px; height:12px; border:2px solid #1a3560; border-top-color:#4a9eff; border-radius:50%; animation:spin .7s linear infinite; }
        .cu-error { font-size:.6rem; color:#8a3030; text-align:center; padding:4px 0; letter-spacing:.5px; }

        .config-area { width:100%; flex:1; display:flex; flex-direction:column; gap:12px; padding:10px; }
        textarea { height:30%; background:#0a0a0a; border:1px solid #333; color:#2ecc71; padding:12px; font-family:monospace; font-size:.8rem; border-radius:10px; resize:none; outline:none; }
        .gif-field { background:#0a0a0a; border:1px solid #333; color:#aaa; padding:10px 12px; font-family:monospace; font-size:.78rem; border-radius:10px; outline:none; width:100%; }
        .gif-field::placeholder { color:#444; }
        .btn-save { background:var(--glow); color:#fff; border:none; padding:13px; border-radius:10px; font-weight:bold; cursor:pointer; font-size:.9rem; }
        .btn-cancel { background:transparent; color:#555; border:none; padding:13px; font-weight:bold; cursor:pointer; margin-bottom:12px; }
        .field-label { font-size:.6rem; color:#666; text-transform:uppercase; letter-spacing:1px; margin-bottom:2px; }

        /* ── Botões fixos ────────────────────────────────────────────────── */
        #log-btn {
            position:fixed; bottom:18px; left:18px; z-index:500;
            width:36px; height:36px; border-radius:50%;
            background:rgba(10,10,30,.85); border:1px solid #1a2540; color:#334; font-size:.9rem;
            display:flex; align-items:center; justify-content:center;
            cursor:pointer; transition:all .2s; box-shadow:0 2px 8px rgba(0,0,0,.5);
        }
        #log-btn:hover, #log-btn:active { border-color:var(--glow); color:var(--glow); }

        /* ── Botão teste de velocidade ───────────────────────────────────── */
        #speedtest-btn {
            position:fixed; top:14px; right:14px; z-index:500;
            width:36px; height:36px; border-radius:50%;
            background:rgba(10,10,30,.85); border:1px solid #1a2540; color:#444;
            font-size:.85rem;
            display:flex; align-items:center; justify-content:center;
            cursor:pointer; transition:all .25s; box-shadow:0 2px 8px rgba(0,0,0,.5);
        }
        #speedtest-btn:hover, #speedtest-btn:active { border-color:#2ecc71; color:#2ecc71; }

