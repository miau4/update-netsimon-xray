function startTimer() {
    var stored = localStorage.getItem('tunnelConnectTime');
    if (stored) {
        connectTime = parseInt(stored, 10);
    } else {
        connectTime = Date.now();
        localStorage.setItem('tunnelConnectTime', connectTime);
    }
    clearInterval(timerInterval);
    timerInterval = setInterval(function() {
        // Watchdog de expiração exata — ver bloco de comentários acima.
        // Roda antes de atualizar o cronômetro: se o horário exato de
        // validade já passou, interrompe a exibição de "CONECTADO" e mostra
        // o bloqueio, em vez de seguir contando o tempo normalmente.
        if (window._activeExpiryMs !== null && Date.now() >= window._activeExpiryMs) {
            showAccessExpiredPopup(window._activeExpiryDateStr);
            return;
        }
        var e = Math.floor((Date.now() - connectTime) / 1000),
            h = Math.floor(e / 3600),
            m = Math.floor((e % 3600) / 60),
            s = e % 60;
        document.getElementById('timer-display').textContent =
            (h < 10 ? '0' : '') + h + ':' +
            (m < 10 ? '0' : '') + m + ':' +
            (s < 10 ? '0' : '') + s;
    }, 1000);
}

function stopTimer() {
    clearInterval(timerInterval);
    timerInterval = null;
    localStorage.removeItem('tunnelConnectTime');
    document.getElementById('timer-display').textContent = '--:--:--';
}

