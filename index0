<body>

<canvas id="neon-canvas"></canvas>
<div id="bg-layer"></div>
<div id="update-toast"></div>

<header>
    <div class="logo-wrap" onclick="checkUpdatesManual()" title="Toque para verificar atualizações">
        <!-- photo-frame: contêiner que recorta o círculo e garante fundo sólido
             atrás da foto. background-color direto na <img> com object-fit:cover
             não pinta de forma confiável atrás de PNG/WebP com canal alfa em
             algumas versões do WebView Android — colocar o fundo no <div> pai
             com overflow:hidden resolve isso de forma garantida. -->
        <div class="photo-frame">
            <img id="logo-img"
                 src="file:///android_asset/logo.png"
                 onerror="this.onerror=null;this.src='https://i.ibb.co/ccC6BNw/ei-1699404424073-removebg-preview.png'"/>
            <!-- Camada opaca reservada para a foto do usuário: fica por cima
                 da <img>, isolada (isolation:isolate) do resto da UI, e é
                 sempre pintada com fundo sólido antes da foto — nada abaixo
                 dela (fundo animado, partículas) pode aparecer através. -->
            <canvas id="logo-photo-canvas"></canvas>
        </div>
        <!-- foguete orbitante -->
        <svg class="orbit-rocket" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 18 18" fill="none">
            <path d="M9 1 C9 1 13 3 13 8 L11 10 L7 10 L5 8 C5 3 9 1 9 1Z" fill="#007BFF" stroke="#00cfff" stroke-width=".8"/>
            <circle cx="9" cy="7" r="1.6" fill="#00cfff" opacity=".9"/>
            <path d="M7 10 L6 13 L9 11.5 L12 13 L11 10Z" fill="#6F00FF" opacity=".85"/>
            <path d="M5 8 L3 9.5 L5 10Z" fill="#f39c12" opacity=".8"/>
            <path d="M13 8 L15 9.5 L13 10Z" fill="#f39c12" opacity=".8"/>
        </svg>
    </div>
</header>

<main>
    <!-- HOME -->
    <section id="home" class="active">
        <div class="info-container">
            <div class="info-box breeze-card">
                <span class="info-label">CONECTADO</span>
                <span class="info-value" id="timer-display">--:--:--</span>
                <span class="carrier-value" id="carrier-display">--</span>
            </div>
            <div class="info-box breeze-card" onclick="requestPing()" style="cursor:pointer">
                <span class="info-label">IP LOCAL / PING</span>
                <span class="info-value" id="ip-display" style="font-size:.7rem;display:block;line-height:1.4">--</span>
                <span class="info-value" id="ping-display" style="font-size:.82rem">-- ms</span>
            </div>
        </div>

        <div id="user-info-card">
            <div class="cu-header">
                <span class="cu-title">👤 CONTA SSH</span>
                <button class="cu-refresh-btn" id="cu-refresh-btn" onclick="refreshCheckUser()" title="Atualizar">
                    <span>↻</span>
                </button>
            </div>
            <div class="cu-loading" id="cu-loading">
                <div class="cu-spin"></div>
                <span>CONSULTANDO SERVIDOR...</span>
            </div>
            <div class="cu-grid" id="cu-grid" style="display:none">
                <div class="cu-item"><span class="cu-item-label">Usuário</span><span class="cu-item-value" id="cu-username">--</span></div>
                <div class="cu-item"><span class="cu-item-label">Validade</span><span class="cu-item-value" id="cu-expiry">--</span></div>
                <div class="cu-item"><span class="cu-item-label">Dias restantes</span><span class="cu-item-value" id="cu-days">--</span></div>
                <div class="cu-item"><span class="cu-item-label">Conexões</span><span class="cu-item-value" id="cu-conns">--</span></div>
            </div>
            <div class="cu-error" id="cu-error" style="display:none"></div>
        </div>

        <button class="operator-btn" id="operator-btn" onclick="openOperatorModal()">
            <div class="operator-circle">
                <img id="op-circle-img"
                     src="file:///android_asset/operadora.png"
                     onerror="this.onerror=null;this.src='https://i.ibb.co/gLrmNT8G/imagem-2026-03-27-111301414-removebg-preview.png'"/>
            </div>
