    // =============================================================================
// onTunnelState
// =============================================================================
window.onTunnelState = function(state) {
    // Durante a varredura silenciosa do LIGAR (ver AUTO-CONNECT abaixo) o app
    // liga/desliga o túnel várias vezes internamente para testar cada opção.
    // Esses estados intermediários não devem "vazar" pra UI (o botão/label
    // ficariam piscando LIGAR/PARAR). window.onTunnelState só volta a valer
    // quando a varredura termina (sucesso real ou todas as opções esgotadas).
    //
    // CORREÇÃO: antes, esse "return" descartava também o MOTIVO real de cada
    // falha nativa (ex.: "ssh_auth_failed" quando a senha está errada) — por
    // isso, ao esgotar todas as opções, o app só sabia mostrar o popup
    // genérico "SEM CONEXÃO", mesmo quando o problema real era credencial
    // inválida. Agora guardamos o último erro em _autoConnLastError antes de
    // sair, pra _autoTryOption poder usar esse motivo real no resultado final.
    if (window._autoConnScanning) {
        if (!state.running && state.error) window._autoConnLastError = state.error;
        return;
    }
    var btn = document.getElementById('btn-connection'), sl = document.getElementById('status-label');
    if (window.setNeonSuspended) window.setNeonSuspended(false);
    if (state.running) {
        isConnected = true; isSshConnecting = false;
        window._expiredPopupShown = false;
        btn.classList.add('active'); btn.classList.remove('connecting');
        btn.disabled = false; btn.innerText = 'PARAR';
        sl.innerText = 'CONECTADO'; sl.className = 'status-text connected';
        hideToast();
        startTimer(); // ← agora retoma do localStorage se já estava conectado
        pingFallbackTimer = setTimeout(function() {
            if (document.getElementById('ping-display').textContent === 'aguarde...')
                document.getElementById('ping-display').textContent = '--';
        }, 6000);
    } else {
        isConnected = false; isSshConnecting = false;
        window._activeExpiryMs = null; // desliga o watchdog de expiração — nada a monitorar sem túnel ativo
        btn.classList.remove('active', 'connecting');
        btn.disabled = false; btn.innerText = 'LIGAR';
        hideToast();
        stopTimer(); // ← agora também limpa o localStorage
        document.getElementById('ping-display').textContent = '-- ms';
        document.getElementById('ip-display').textContent = '--';


        if (state.error) {
            var msg = state.error;
            if (msg === 'ssh_auth_failed')          msg = 'CREDENCIAIS INVÁLIDAS';
            else if (msg === 'ssh_payload_error')   msg = 'PAYLOAD / CDN FALHOU';
            else if (msg.startsWith('ssh_error:'))  msg = 'ERRO: ' + msg.replace('ssh_error:', '');
            else if (msg === 'permission_denied')   msg = 'PERMISSÃO NEGADA';
            else if (msg === 'import_failed')       msg = 'ERRO AO IMPORTAR CONFIG';
            else if (msg === 'no_operator_selected') msg = 'SELECIONE UMA OPERADORA';
            else if (msg === 'xray_start_failed')   msg = 'XRAY FALHOU AO INICIAR';
            sl.innerText = msg; sl.className = 'status-text error-text';
            if (msg === 'CREDENCIAIS INVÁLIDAS') {
                var op = allOperators.find(function(o) { return o.name === selectedOpName; });
                var isSsh = op && (op.mode === 'SSH_DIRECT' || op.mode === 'SSL_PROXY');
                if (isSsh) openSshPopup(false, null, selectedOpName);
            }
        } else {
            sl.innerText = ''; sl.className = 'status-text';
        }
    }
};

