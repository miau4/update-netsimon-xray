/* ── Botão diagnóstico ───────────────────────────────────────────────── */
#diag-btn {
    position:fixed; bottom:18px; right:62px; z-index:500;
    width:36px; height:36px; border-radius:50%;
    background:rgba(10,10,30,.85); border:1px solid #1a2540; color:#444;
    font-size:1rem;
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; transition:all .25s; box-shadow:0 2px 8px rgba(0,0,0,.5);
}
#diag-btn.running {
    border-color:#f39c12; color:#f39c12;
    box-shadow:0 0 10px rgba(243,156,18,.45);
    animation:pulseYellow 1.5s ease-in-out infinite;
}
@keyframes pulseYellow { 0%,100%{box-shadow:0 0 6px rgba(243,156,18,.4);} 50%{box-shadow:0 0 16px rgba(243,156,18,.8);} }

/* ── Popup diagnóstico ───────────────────────────────────────────────── */
#diag-popup-overlay {
    display:none; position:fixed; inset:0; z-index:2000;
    background:rgba(0,0,0,.88); align-items:center; justify-content:center;
}
#diag-popup-overlay.open { display:flex; }
.diag-popup {
    position:fixed; top:50%; left:50%; transform:translate(-50%,-50%);
    width:calc(100% - 40px); max-width:340px;
    background:#08080f; border:1px solid #1a2a50;
    border-radius:18px; padding:24px 20px 20px;
    animation:popIn .25s ease; z-index:2001;
}
.diag-anim-area {
    display:flex; align-items:center; justify-content:center;
    margin-bottom:16px; position:relative; height:80px;
}
.diag-log-area {
    background:#020510; border:1px solid #0d1828; border-radius:10px;
    padding:10px 12px; min-height:80px; max-height:120px;
    overflow-y:auto; margin-bottom:16px; font-family:monospace;
    font-size:.65rem; color:#2a4060; line-height:1.6;
}
.diag-log-line { margin-bottom:2px; }
.diag-log-line.ok   { color:#2ecc71; }
.diag-log-line.warn { color:#f39c12; }
.diag-log-line.err  { color:#e74c3c; }
.diag-log-line.info { color:#4a9eff; }
.diag-result-box {
    display:none; background:#050510; border-radius:12px;
    padding:16px; text-align:center; margin-bottom:16px;
}
.diag-result-box.show { display:block; }
.diag-result-icon { font-size:2rem; margin-bottom:8px; }
.diag-result-title { font-size:.85rem; font-weight:700; color:#fff; margin-bottom:6px; }
.diag-result-msg { font-size:.68rem; color:#888; line-height:1.5; }

        #routing-btn.active {
            border-color:#2ecc71; color:#2ecc71;
            box-shadow:0 0 10px rgba(46,204,113,.45);
        }
        #routing-btn:active { opacity:.7; }

        /* ── Botão de reconexão automática (watchdog) ────────────────────── */
        #watchdog-btn {
            position:fixed; bottom:18px; right:106px; z-index:500;
            width:36px; height:36px; border-radius:50%;
            background:rgba(10,10,30,.85); border:1px solid #1a2540; color:#444;
            font-size:1rem;
            display:flex; align-items:center; justify-content:center;
            cursor:pointer; transition:all .25s; box-shadow:0 2px 8px rgba(0,0,0,.5);
        }
        #watchdog-btn.active {
            border-color:#f39c12; color:#f39c12;
            box-shadow:0 0 10px rgba(243,156,18,.45);
        }
        #watchdog-btn:active { opacity:.7; }

        #ssh-cred-btn {
            position:fixed; bottom:18px; right:18px; z-index:500;
            width:36px; height:36px; border-radius:50%;
            background:rgba(10,10,30,.85); border:1px solid #1a2540; color:#334; font-size:.9rem;
            display:flex; align-items:center; justify-content:center;
            cursor:pointer; transition:all .2s; box-shadow:0 2px 8px rgba(0,0,0,.5);
        }
        #ssh-cred-btn:hover, #ssh-cred-btn:active { border-color:var(--glow); color:var(--glow); }
        #ssh-cred-btn.has-creds::after { content:''; position:absolute; top:2px; right:2px; width:8px; height:8px; border-radius:50%; background:var(--green); border:1px solid #000; }

        /* ── Botão QR compartilhar (transmissor) ─────────────────────────── */
        #qr-share-btn {
            position:fixed; bottom:18px; left:62px; z-index:500;
            width:36px; height:36px; border-radius:50%;
            background:rgba(10,10,30,.85); border:1px solid #1a2540;
            display:flex; align-items:center; justify-content:center;
            cursor:pointer; transition:all .25s; box-shadow:0 2px 8px rgba(0,0,0,.5);
        }
        #qr-share-btn:active { opacity:.7; }
        #qr-share-btn.share-active {
            border-color:#2ecc71;
            box-shadow:0 0 10px rgba(46,204,113,.5);
            animation:shareGlow 2.5s ease-in-out infinite;
        }
        #qr-share-btn.share-active svg path,
        #qr-share-btn.share-active svg circle,
        #qr-share-btn.share-active svg line { stroke:#2ecc71; }
        #qr-share-btn.share-active::after {
            content:''; position:absolute; top:1px; right:1px;
            width:9px; height:9px; border-radius:50%;
            background:#2ecc71; border:1.5px solid #000;
            box-shadow:0 0 5px rgba(46,204,113,.8);
        }

        /* qr-receive-btn e apk-share-btn removidos (ver instruções do app:
           só o botão de ENVIAR compartilhamento fica; instruções do
           receptor agora aparecem dentro do próprio popup de ENVIAR.
           Compartilhar APK foi desativado — apps compartilhados não abrem
           no aparelho de destino por causa da assinatura ativa). */

        /* ── Botão limpar armazenamento ───────────────────────────────────── */
        #clear-storage-btn {
            position:fixed; bottom:18px; left:106px; z-index:500;
            width:36px; height:36px; border-radius:50%;
            background:rgba(10,10,30,.85); border:1px solid #1a2540; color:#444;
            display:flex; align-items:center; justify-content:center;
            cursor:pointer; transition:all .25s; box-shadow:0 2px 8px rgba(0,0,0,.5);
        }
        #clear-storage-btn:hover, #clear-storage-btn:active { border-color:#e74c3c; color:#e74c3c; opacity:.85; }

        /* ── Popup de confirmação (limpar armazenamento) ─────────────────── */
        #confirm-popup-overlay { display:none; position:fixed; inset:0; z-index:2100; background:rgba(0,0,0,.85); align-items:center; justify-content:center; }
        #confirm-popup-overlay.open { display:flex; }
        .confirm-popup { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); width:calc(100% - 40px); max-width:340px; background:#0a0a1a; border:1px solid #3a1520; border-radius:18px; padding:24px 20px 20px; animation:popIn .25s ease; z-index:2101; }
        .confirm-popup-icon { width:48px; height:48px; border-radius:50%; background:rgba(231,76,60,.12); border:1px solid rgba(231,76,60,.3); display:flex; align-items:center; justify-content:center; font-size:1.4rem; margin:0 auto 14px; }
        .confirm-popup h3 { text-align:center; font-size:.9rem; font-weight:700; letter-spacing:1px; margin-bottom:4px; color:#fff; }
        .confirm-popup-sub { text-align:center; font-size:.68rem; color:#888; margin-bottom:18px; line-height:1.5; }
        .confirm-danger-btn { display:block; width:100%; background:rgba(231,76,60,.15); border:1px solid rgba(231,76,60,.35); color:#e74c3c; padding:11px; border-radius:10px; font-size:.8rem; font-weight:700; letter-spacing:1px; cursor:pointer; margin-bottom:10px; }
        .confirm-danger-btn:active { background:rgba(231,76,60,.3); }
        .confirm-cancel-btn { display:block; width:100%; background:transparent; border:1px solid #1a2540; color:#555; padding:11px; border-radius:10px; font-size:.8rem; cursor:pointer; }

        /* ── Popup QR ────────────────────────────────────────────────────── */
        #qr-popup-overlay {
            display:none; position:fixed; inset:0; z-index:2000;
            background:rgba(0,0,0,.88); align-items:center; justify-content:center;
        }
        #qr-popup-overlay.open { display:flex; }

        .qr-popup {
            position:fixed; top:50%; left:50%; transform:translate(-50%,-50%);
            width:calc(100% - 40px); max-width:340px;
            background:#0a0a1a; border:1px solid #1a2a50;
            border-radius:18px; padding:22px 20px 18px;
            animation:popIn .25s ease; z-index:2001;
            max-height:90vh; overflow-y:auto;
        }
        .qr-popup-icon { width:44px; height:44px; border-radius:50%; background:rgba(0,123,255,.12); border:1px solid rgba(0,123,255,.3); display:flex; align-items:center; justify-content:center; font-size:1.3rem; margin:0 auto 12px; }
        .qr-popup h3 { text-align:center; font-size:.88rem; font-weight:700; letter-spacing:1px; margin-bottom:4px; color:#fff; }
        .qr-popup-sub { text-align:center; font-size:.65rem; color:#555; margin-bottom:16px; line-height:1.5; white-space:pre-line; }

        /* ── Endereço principal (antes era o canvas do QR, removido) ──────── */
        #qr-canvas-wrap {
            display:flex; align-items:center; justify-content:center;
            border-radius:12px; margin-bottom:10px; min-height:0;
        }

        /* ── Lista de IPs (separada do canvas) ─────────────────────────── */
        #qr-ip-list-wrap { margin-bottom:10px; }

        #qr-addr-label { text-align:center; font-size:.78rem; font-family:monospace; color:#2ecc71; font-weight:700; letter-spacing:1px; margin-bottom:8px; }
        #qr-status-msg { text-align:center; font-size:.68rem; color:#f39c12; margin-bottom:12px; min-height:16px; letter-spacing:.5px; }

        /* Lista de IPs no popup transmissor */
        .ip-list-box { background:#050510; border:1px solid #1a2540; border-radius:10px; padding:10px 12px; }
        .ip-list-title { font-size:.55rem; color:#3a6090; text-transform:uppercase; letter-spacing:1.5px; font-weight:700; margin-bottom:8px; }
        .ip-list-row { display:flex; align-items:center; justify-content:space-between; padding:5px 0; border-bottom:1px solid #0d1828; }
        .ip-list-row:last-child { border-bottom:none; }
        .ip-list-addr { font-family:monospace; font-size:.8rem; color:#2ecc71; font-weight:700; }
        .ip-list-copy { background:rgba(46,204,113,.1); border:1px solid rgba(46,204,113,.2); color:#2ecc71; border-radius:6px; padding:3px 8px; font-size:.62rem; cursor:pointer; }
        .ip-list-copy:active { background:rgba(46,204,113,.3); }

        .qr-close-btn { display:block; width:100%; background:transparent; border:1px solid #1a2540; color:#555; padding:11px; border-radius:10px; font-size:.8rem; cursor:pointer; }
        .qr-close-nodisable-btn { display:block; width:100%; background:rgba(46,204,113,.08); border:1px solid rgba(46,204,113,.2); color:#2ecc71; padding:11px; border-radius:10px; font-size:.8rem; font-weight:700; cursor:pointer; margin-bottom:8px; }
        .qr-stop-btn { display:block; width:100%; background:rgba(231,76,60,.08); border:1px solid rgba(231,76,60,.25); color:#e74c3c; padding:11px; border-radius:10px; font-size:.8rem; font-weight:700; cursor:pointer; margin-bottom:8px; }

        /* ── Popup de roteamento ─────────────────────────────────────────── */
        #routing-popup-overlay { display:none; position:fixed; inset:0; z-index:2000; background:rgba(0,0,0,.80); align-items:center; justify-content:center; }
        #routing-popup-overlay.open { display:flex; }
        .routing-popup { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); width:calc(100% - 40px); max-width:340px; background:#0a0a1a; border:1px solid #1a2a50; border-radius:18px; padding:24px 20px 20px; animation:popIn .25s ease; z-index:2001; }
        .routing-popup-icon { width:48px; height:48px; border-radius:50%; background:rgba(46,204,113,.12); border:1px solid rgba(46,204,113,.3); display:flex; align-items:center; justify-content:center; font-size:1.4rem; margin:0 auto 14px; }
        .routing-popup h3 { text-align:center; font-size:.9rem; font-weight:700; letter-spacing:1px; margin-bottom:4px; color:#fff; }
        .routing-popup-sub { text-align:center; font-size:.68rem; color:#555; margin-bottom:18px; line-height:1.5; }
        .routing-info-box { background:#050510; border:1px solid #1a2540; border-radius:10px; padding:14px 16px; margin-bottom:16px; text-align:center; }
        .routing-info-label { font-size:.55rem; color:#3a6090; text-transform:uppercase; letter-spacing:1.5px; font-weight:700; margin-bottom:6px; display:block; }
        .routing-info-value { font-size:1.1rem; font-family:monospace; font-weight:900; color:#2ecc71; letter-spacing:2px; }
        .routing-info-hint { font-size:.6rem; color:#2a4060; margin-top:6px; display:block; line-height:1.4; }
        .routing-copy-btn { display:block; width:100%; background:rgba(46,204,113,.12); border:1px solid rgba(46,204,113,.25); color:#2ecc71; padding:11px; border-radius:10px; font-size:.8rem; font-weight:700; letter-spacing:1px; cursor:pointer; margin-bottom:10px; }
        .routing-copy-btn:active { background:rgba(46,204,113,.25); }
        .routing-close-btn { display:block; width:100%; background:transparent; border:1px solid #1a2540; color:#555; padding:11px; border-radius:10px; font-size:.8rem; cursor:pointer; }

        /* ── Modais ─────────────────────────────────────────────────────── */
        .bottom-modal { display:none; position:fixed; inset:0; z-index:1000; background:rgba(0,0,0,.75); align-items:flex-end; }
        .bottom-modal.open { display:flex; animation:fadeIn .2s; }
        .modal-sheet { width:100%; max-width:450px; margin:0 auto; background:#0a0a18; border-top:1px solid #222; border-radius:18px 18px 0 0; padding:0 0 24px; animation:slideUp .3s ease; max-height:80vh; overflow-y:auto; }
        .modal-handle { width:40px; height:4px; background:#333; border-radius:2px; margin:12px auto 16px; }
        .modal-title { text-align:center; font-size:.7rem; color:#555; text-transform:uppercase; letter-spacing:2px; margin-bottom:16px; }
        .cat-tabs { display:flex; gap:8px; padding:0 16px; overflow-x:auto; scrollbar-width:none; margin-bottom:14px; }
        .cat-tabs::-webkit-scrollbar { display:none; }
        .cat-tab { flex-shrink:0; padding:6px 16px; border:1px solid #333; border-radius:20px; background:transparent; color:#777; font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; cursor:pointer; transition:all .2s; }
        .cat-tab.active { border-color:var(--glow); color:#fff; background:rgba(0,123,255,.15); }
        .op-list { padding:0 12px; display:flex; flex-direction:column; gap:8px; }
        .op-item { display:flex; align-items:center; gap:12px; padding:12px 14px; background:#0f1626; border:1px solid #1a2540; border-radius:12px; cursor:pointer; transition:all .2s; position:relative; }
        .op-item:active { border-color:var(--glow); background:#0a1a35; }
        .op-item.selected { border-color:var(--green); background:rgba(46,204,113,.07); }
        .op-icon { width:40px; height:40px; border-radius:50%; object-fit:cover; border:1px solid #222; flex-shrink:0; background:#0a0a0a; }
        .op-info { flex:1; min-width:0; }
        .op-name { font-size:.82rem; font-weight:700; color:#eee; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .op-desc { font-size:.65rem; color:#555; margin-top:2px; }
        .op-mode-badge { font-size:.55rem; font-weight:700; letter-spacing:1px; padding:3px 8px; border-radius:8px; text-transform:uppercase; flex-shrink:0; }
        .badge-ssh   { background:rgba(0,123,255,.2); color:#4a9eff; border:1px solid #1a4a80; }
        .badge-v2ray { background:rgba(111,0,255,.2); color:#a855f7; border:1px solid #4a1a80; }
        .badge-ssl   { background:rgba(46,204,113,.2); color:#2ecc71; border:1px solid #1a5035; }
        .badge-other { background:rgba(255,255,255,.1); color:#aaa; border:1px solid #333; }
        .op-check { width:18px; height:18px; border-radius:50%; border:2px solid #333; flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:.65rem; transition:all .2s; }
        .op-item.selected .op-check { background:var(--green); border-color:var(--green); }
        .op-item.selected .op-check::after { content:'✓'; color:#000; font-weight:900; }
        .modal-close-btn { display:block; width:calc(100% - 32px); margin:16px 16px 0; padding:14px; background:transparent; border:1px solid #222; color:#555; border-radius:12px; font-size:.85rem; cursor:pointer; }

        #ssh-popup-overlay { display:none; position:fixed; inset:0; z-index:2000; background:rgba(0,0,0,.85); align-items:center; justify-content:center; }
        #ssh-popup-overlay.open { display:flex; }
        .ssh-popup { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); width:calc(100% - 40px); max-width:360px; background:#0a0a1a; border:1px solid #1a2a50; border-radius:18px; padding:24px 20px 20px; animation:popIn .25s ease; z-index:2001; }
        .ssh-popup-icon { width:48px; height:48px; border-radius:50%; background:rgba(0,123,255,.15); border:1px solid #1a4a80; display:flex; align-items:center; justify-content:center; font-size:1.4rem; margin:0 auto 14px; }
        .ssh-popup h3 { text-align:center; font-size:.9rem; font-weight:700; letter-spacing:1px; margin-bottom:4px; }
        .ssh-popup .ssh-popup-sub { text-align:center; font-size:.68rem; color:#555; margin-bottom:20px; line-height:1.5; }
        .ssh-field-group { display:flex; flex-direction:column; gap:10px; margin-bottom:18px; }
        .ssh-field-wrap { position:relative; }
        .ssh-field-label { font-size:.58rem; color:#555; text-transform:uppercase; letter-spacing:1px; margin-bottom:4px; display:block; }
        .ssh-field { width:100%; background:#050510; border:1px solid #1a2540; color:#fff; padding:12px 14px; border-radius:10px; font-family:monospace; font-size:.88rem; outline:none; transition:border-color .2s; }
        .ssh-field:focus { border-color:var(--glow); }
        .ssh-field::placeholder { color:#2a3040; }
        .pwd-toggle { position:absolute; right:12px; top:50%; transform:translateY(-50%); background:none; border:none; color:#444; cursor:pointer; font-size:.8rem; padding:4px; }
        .ssh-popup-btns { display:flex; gap:10px; }
        .ssh-btn-confirm { flex:1; background:var(--glow); color:#fff; border:none; padding:13px; border-radius:10px; font-weight:700; font-size:.88rem; cursor:pointer; }
        .ssh-btn-cancel { flex:0 0 auto; background:transparent; color:#444; border:1px solid #1a2540; padding:13px 18px; border-radius:10px; font-size:.88rem; cursor:pointer; }
        .ssh-error-msg { display:none; font-size:.68rem; color:var(--red); text-align:center; margin-top:-10px; margin-bottom:10px; }
        .ssh-error-msg.show { display:block; }
        .ssh-saved-info { display:flex; align-items:center; gap:8px; background:rgba(46,204,113,.08); border:1px solid rgba(46,204,113,.2); border-radius:8px; padding:8px 12px; margin-bottom:16px; font-size:.68rem; color:#2ecc71; }

        /* LOG MODAL */
        #log-modal { display:none; position:fixed; inset:0; z-index:3000; background:#02050e; flex-direction:column; }
        #log-modal.open { display:flex; animation:fadeIn .15s; }
        .log-header { display:flex; align-items:center; justify-content:space-between; padding:12px 14px 10px; background:linear-gradient(180deg,#030a1a 0%,#020610 100%); border-bottom:1px solid #0d1828; flex-shrink:0; }
        .log-title-wrap { display:flex; flex-direction:column; gap:2px; }
        .log-title { font-size:.72rem; font-weight:800; color:#3a7abf; text-transform:uppercase; letter-spacing:2.5px; }
        .log-subtitle { font-size:.52rem; color:#1a3050; letter-spacing:1px; text-transform:uppercase; }
        .log-header-btns { display:flex; gap:6px; align-items:center; }
        .log-hbtn { background:transparent; border:1px solid #0d1828; color:#2a4060; padding:5px 10px; border-radius:6px; font-size:.6rem; font-weight:700; text-transform:uppercase; letter-spacing:1px; cursor:pointer; transition:all .15s; }
        .log-hbtn:active { border-color:#3a7abf; color:#3a7abf; }
        .log-hbtn.danger:active { border-color:#8a2020; color:#e74c3c; }
        #log-close-btn { background:transparent; border:none; color:#2a4060; font-size:1rem; cursor:pointer; padding:4px 6px; line-height:1; }
        #log-close-btn:active { color:#fff; }
        .log-status-bar { display:flex; align-items:center; gap:8px; padding:5px 14px 4px; background:#020610; border-bottom:1px solid #080f1e; flex-shrink:0; }
        .log-live-dot { width:6px; height:6px; border-radius:50%; background:#1a5a30; flex-shrink:0; }
        .log-live-dot.active { background:#2ecc71; box-shadow:0 0 5px rgba(46,204,113,.6); animation:blink 1.4s ease-in-out infinite; }
        @keyframes blink { 0%,100%{opacity:1;} 50%{opacity:.25;} }
        .log-count { font-size:.56rem; color:#1a3050; letter-spacing:1px; margin-left:auto; }
        #log-content { flex:1; overflow-y:auto; padding:4px 0; scroll-behavior:smooth; }
        #log-content::-webkit-scrollbar { width:3px; }
        #log-content::-webkit-scrollbar-track { background:#020610; }
        #log-content::-webkit-scrollbar-thumb { background:#0d1828; border-radius:2px; }
        .al-entry { display:flex; align-items:flex-start; padding:7px 14px 6px; border-bottom:1px solid rgba(255,255,255,.022); gap:0; }
        .al-time { flex-shrink:0; width:54px; font-size:.6rem; font-family:'Courier New', monospace; color:#0d2035; margin-top:1px; letter-spacing:.3px; }
        .al-icon { flex-shrink:0; width:22px; font-size:.78rem; text-align:center; margin-top:-1px; }
        .al-msg { flex:1; font-size:.72rem; line-height:1.4; letter-spacing:.2px; word-break:break-word; }
        .al-success .al-msg { color:#2ecc71; } .al-success .al-time { color:#fff; }
        .al-error .al-msg   { color:#e74c3c; } .al-error .al-time  { color:#fff; }
        .al-warn .al-msg    { color:#e67e22; } .al-warn .al-time   { color:#fff; }
        .al-connect .al-msg  { color:#3498db; } .al-connect .al-time { color:#fff; }
        .al-disconnect .al-msg  { color:#7f8c8d; } .al-disconnect .al-time { color:#fff; }
        .al-ping .al-msg  { color:#1abc9c; } .al-ping .al-time { color:#fff; }
        .al-ip .al-msg  { color:#5dade2; } .al-ip .al-time { color:#fff; }
        .al-user .al-msg  { color:#a569bd; } .al-user .al-time { color:#fff; }
        .al-update .al-msg  { color:#58d68d; } .al-update .al-time { color:#fff; }
        .al-info .al-msg  { color:#2a4060; } .al-info .al-time { color:#fff; }
        .al-reconnect .al-msg  { color:#f39c12; } .al-reconnect .al-time { color:#fff; }
        .log-empty { display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; gap:10px; color:#0d1828; padding:40px; }
        .log-empty-icon { font-size:2rem; opacity:.4; }
        .log-empty-text { font-size:.65rem; letter-spacing:2px; text-transform:uppercase; text-align:center; line-height:1.6; }
    </style>
