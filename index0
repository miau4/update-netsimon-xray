var _diagRunning = false;
var _diagAborted = false;

function startDiagnosis() {
    if (_diagRunning) return;
    var currentOp = allOperators.find(function(o){ return o.name === selectedOpName; });
    if (!currentOp) { showToast('⚠ Selecione uma operadora primeiro', '#e74c3c'); return; }
    var sameCategory = allOperators.filter(function(o){
        return o.category && currentOp.category && o.category.name === currentOp.category.name;
    });
    if (sameCategory.length === 0) { showToast('⚠ Nenhuma opção disponível', '#e74c3c'); return; }
    _openDiagPopup();
    _runDiagnosis(sameCategory, currentOp);
}

function _openDiagPopup() {
    if (!document.getElementById('diag-popup-overlay')) _buildDiagPopup();
    document.getElementById('diag-log-content').innerHTML = '';
    document.getElementById('diag-result-box').classList.remove('show');
    document.getElementById('diag-close-btn').style.display = 'none';
    document.getElementById('diag-popup-overlay').classList.add('open');
    document.getElementById('diag-btn').classList.add('running');
    _diagRunning = true;
    _diagAborted = false;
    _startDiagAnim();
}

function _buildDiagPopup() {
    var overlay = document.createElement('div');
    overlay.id = 'diag-popup-overlay';
    overlay.innerHTML =
        '<div class="diag-popup">' +
            '<div style="text-align:center;margin-bottom:12px">' +
                '<div style="font-size:.6rem;color:#3a6090;text-transform:uppercase;letter-spacing:2px;font-weight:700">DIAGNÓSTICO DE CONEXÃO</div>' +
            '</div>' +
            '<div class="diag-anim-area">' +
                '<svg id="diag-svg" width="80" height="80" viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg">' +
                    '<path d="M10 38 Q40 10 70 38" stroke="#1a3a6a" stroke-width="3" fill="none" stroke-linecap="round"/>' +
                    '<path d="M18 46 Q40 24 62 46" stroke="#1a4a8a" stroke-width="3" fill="none" stroke-linecap="round"/>' +
                    '<path d="M26 54 Q40 38 54 54" stroke="#1a5aaa" stroke-width="3" fill="none" stroke-linecap="round" id="diag-wifi-inner"/>' +
                    '<circle cx="40" cy="62" r="3" fill="#1a5aaa" id="diag-wifi-dot"/>' +
                    '<g id="diag-wrench">' +
                        '<circle cx="40" cy="40" r="12" fill="rgba(243,156,18,0.15)" stroke="#f39c12" stroke-width="1.2"/>' +
                        '<text x="40" y="45" text-anchor="middle" font-size="14" fill="#f39c12">🔧</text>' +
                    '</g>' +
                '</svg>' +
            '</div>' +
            '<div class="diag-log-area" id="diag-log-content"></div>' +
            '<div class="diag-result-box" id="diag-result-box">' +
                '<div class="diag-result-icon" id="diag-result-icon"></div>' +
                '<div class="diag-result-title" id="diag-result-title"></div>' +
                '<div class="diag-result-msg" id="diag-result-msg"></div>' +
                '<div id="diag-result-action" style="margin-top:12px"></div>' +
            '</div>' +
            '<button id="diag-close-btn" style="display:none;width:100%;background:transparent;border:1px solid #1a2540;color:#555;padding:11px;border-radius:10px;font-size:.8rem;cursor:pointer;margin-top:4px" onclick="closeDiagPopup()">FECHAR</button>' +
            '<button style="width:100%;background:transparent;border:1px solid #3a1520;color:#555;padding:9px;border-radius:10px;font-size:.72rem;cursor:pointer;margin-top:8px" onclick="abortDiagnosis()">CANCELAR</button>' +
        '</div>';
    document.body.appendChild(overlay);
}

var _diagAnimFrame = null;
var _diagAnimAngle = 0;

function _startDiagAnim() {
    var colors = ['#f39c12','#4a9eff','#2ecc71','#f39c12'];
    var colorIdx = 0, colorTick = 0;
    function animStep() {
        if (!_diagRunning) return;
        _diagAnimAngle = (_diagAnimAngle + 4) % 360;
        var wrench = document.getElementById('diag-wrench');
        if (wrench) wrench.setAttribute('transform', 'rotate('+_diagAnimAngle+', 40, 40)');
        colorTick++;
        if (colorTick % 20 === 0) colorIdx = (colorIdx+1) % colors.length;
        var c = colors[colorIdx];
        ['#diag-wifi-inner','#diag-wifi-dot'].forEach(function(sel){
            var el = document.querySelector(sel);
            if (el) { el.setAttribute('stroke', c); el.setAttribute('fill', c); }
        });
        _diagAnimFrame = requestAnimationFrame(animStep);
    }
    _diagAnimFrame = requestAnimationFrame(animStep);
}

function _stopDiagAnim() {
    if (_diagAnimFrame) { cancelAnimationFrame(_diagAnimFrame); _diagAnimFrame = null; }
    ['#diag-wifi-inner','#diag-wifi-dot'].forEach(function(sel){
        var el = document.querySelector(sel);
        if (el) { el.setAttribute('stroke','#2ecc71'); el.setAttribute('fill','#2ecc71'); }
    });
}

function _diagLog(msg, type) {
    var el = document.getElementById('diag-log-content');
    if (!el) return;
    var line = document.createElement('div');
    line.className = 'diag-log-line ' + (type||'info');
    line.textContent = '';
    el.appendChild(line);
    el.scrollTop = el.scrollHeight;
    var i = 0;
    var interval = setInterval(function(){
        if (i < msg.length) { line.textContent += msg[i]; i++; el.scrollTop = el.scrollHeight; }
        else clearInterval(interval);
    }, 18);
}

function _diagShowResult(icon, title, msg, actionHtml) {
    _stopDiagAnim();
    _diagRunning = false;
    document.getElementById('diag-btn').classList.remove('running');
    document.getElementById('diag-result-icon').textContent = icon;
    document.getElementById('diag-result-title').textContent = title;
    document.getElementById('diag-result-msg').textContent = msg;
    document.getElementById('diag-result-action').innerHTML = actionHtml || '';
    document.getElementById('diag-result-box').classList.add('show');
    document.getElementById('diag-close-btn').style.display = 'block';
}

function abortDiagnosis() {
    _diagAborted = true;
    _diagRunning = false;
    _stopDiagAnim();
    document.getElementById('diag-btn').classList.remove('running');
    if (window.Android) Android.stopTunnel();
    closeDiagPopup();
}

function closeDiagPopup() {
    var overlay = document.getElementById('diag-popup-overlay');
    if (overlay) overlay.classList.remove('open');
    _diagRunning = false;
    _diagAborted = false;
    document.getElementById('diag-btn').classList.remove('running');
    if (_diagAnimFrame) { cancelAnimationFrame(_diagAnimFrame); _diagAnimFrame = null; }
}

function _wppBtn() {
    return '<button onclick="if(window.Android&&Android.openExternalUrl){Android.openExternalUrl(\'https://wa.me/55\');}" ' +
           'style="display:flex;align-items:center;justify-content:center;gap:8px;background:#25D366;color:#fff;border:none;border-radius:8px;padding:11px 20px;font-size:.8rem;font-weight:700;cursor:pointer;width:100%;margin-top:4px">' +
           '<span>💬</span> FALAR COM SUPORTE</button>';
}

function _runDiagnosis(options, currentOp) {
    var signal  = (window.Android && Android.getSignalStrength) ? Android.getSignalStrength() : 50;
    var netType = (window.Android && Android.getNetworkType)    ? Android.getNetworkType()    : 'UNKNOWN';
    var weakSignal = signal < 40;
    var is3G = netType === '3G' || netType === '2G';

    _diagLog('📡 Verificando qualidade da rede...', 'info');
    setTimeout(function(){
        if (_diagAborted) return;
        _diagLog('📶 Sinal: ' + signal + '% — Rede: ' + netType, weakSignal || is3G ? 'warn' : 'ok');
        if (weakSignal) _diagLog('⚠ Sinal fraco detectado — continuando diagnóstico...', 'warn');
        if (is3G)       _diagLog('⚠ Rede 3G/2G detectada — continuando diagnóstico...', 'warn');

        var isSsh   = currentOp.mode === 'SSH_DIRECT' || currentOp.mode === 'SSL_PROXY';
        var uuid    = document.getElementById('user-uuid') ? document.getElementById('user-uuid').value.trim() : '';
        var sshUser = (window.Android && Android.storageGet) ? Android.storageGet('ssh_username') || '' : '';

        if (!isSsh && !uuid) {
            _diagLog('❌ Nenhuma chave de acesso inserida', 'err');
            _diagShowResult('🔑', 'CHAVE DE ACESSO AUSENTE',
                'Insira sua chave de acesso (UUID) no campo indicado e tente novamente.',
                _wppBtn());
            return;
        }
        if (isSsh && !sshUser) {
            _diagLog('❌ Credenciais SSH não configuradas', 'err');
            _diagShowResult('🔑', 'CREDENCIAIS NÃO CONFIGURADAS',
                'Configure suas credenciais SSH tocando no botão 🔑 e tente novamente.',
                _wppBtn());
            return;
        }

        _diagLog('🔍 Iniciando testes nas opções disponíveis...', 'info');
        _tryOption(options, 0, weakSignal, is3G, signal, netType);
    }, 800);
}

function _tryOption(options, idx, weakSignal, is3G, signal, netType) {
    if (_diagAborted) return;
    if (idx >= options.length) {
        _diagLog('❌ Nenhuma opção gerou conexão.', 'err');
        var msg = '';
        if (weakSignal || is3G) {
            msg = 'Não foi possível estabelecer conexão. ' +
                  (weakSignal ? 'Sinal insuficiente detectado (' + signal + '%). ' : '') +
                  (is3G ? 'Rede ' + netType + ' com qualidade limitada. ' : '') +
                  'Procure um local com melhor qualidade de sinal.';
            _diagShowResult('📶', 'PROBLEMA DE SINAL', msg, _wppBtn());
        } else {
            _diagShowResult('⚠️', 'SEM CONEXÃO',
                'Não foi possível estabelecer conexão. Entre em contato com o suporte.',
                _wppBtn());
        }
        return;
    }

    var op = options[idx];

    if (idx === 0) {
        // Testa conexão atual sem reiniciar o túnel primeiro
        _diagLog('🔍 Verificando conexão atual: ' + op.name + '...', 'info');
        setTimeout(function() {
            if (_diagAborted) return;
            var probeOk = (window.Android && Android.diagProbe) ? Android.diagProbe() : false;
            if (probeOk) {
                _diagLog('✅ ' + op.name + ' está respondendo!', 'ok');
                if (window.Android && Android.measurePingNow) Android.measurePingNow();
                _diagShowResult('✅', 'CONEXÃO OK',
                    op.name + ' está funcionando normalmente. Nenhuma ação necessária.', '');
                return;
            }
            _diagLog('⚠ Sem resposta na conexão atual. Reiniciando...', 'warn');
            _restartAndProbe(op, options, idx, weakSignal, is3G, signal, netType);
        }, 1500);
    } else {
        _restartAndProbe(op, options, idx, weakSignal, is3G, signal, netType);
    }
}

function _restartAndProbe(op, options, idx, weakSignal, is3G, signal, netType) {
    if (_diagAborted) return;
    _diagLog('🔄 Iniciando: ' + op.name + '...', 'info');
    if (window.Android) Android.stopTunnel();

    setTimeout(function() {
        if (_diagAborted) return;
        if (window.Android && Android.selectOperator) Android.selectOperator(op.name);

        var sshUser = (window.Android && Android.storageGet) ? Android.storageGet('ssh_username') || '' : '';
        var sshPass = (window.Android && Android.storageGet) ? Android.storageGet('ssh_password') || '' : '';
        var uuid    = document.getElementById('user-uuid') ? document.getElementById('user-uuid').value.trim() : '';
        var isSsh   = op.mode === 'SSH_DIRECT' || op.mode === 'SSL_PROXY';

        if (window.Android) {
            if (isSsh) Android.startSshWithCredentials(op.name, sshUser, sshPass);
            else       Android.startTunnelWithCreds(uuid, sshUser, sshPass);
        }

        _diagLog('⏳ Aguardando estabilização...', 'info');

        setTimeout(function() {
            if (_diagAborted) return;
            _diagLog('📡 Testando geração de dados reais...', 'info');
            var probeOk = (window.Android && Android.diagProbe) ? Android.diagProbe() : false;

            if (probeOk) {
                if (window.Android && Android.measurePingNow) Android.measurePingNow();
                _diagLog('✅ ' + op.name + ' gerou dados! Conexão confirmada.', 'ok');
                selectedOpName = op.name;
                if (window.Android && Android.storageSave) Android.storageSave('netsmon_operator', op.name);
                document.getElementById('op-selected-label').textContent = op.name;
                if (op.icon) document.getElementById('op-circle-img').src = op.icon;
                var msg = weakSignal && is3G
                    ? op.name + ' funcionando. Sinal fraco (' + signal + '%) + rede ' + netType + ' podem limitar a velocidade.'
                    : weakSignal
                        ? op.name + ' funcionando. Sinal fraco (' + signal + '%) pode afetar a estabilidade.'
                        : is3G
                            ? op.name + ' funcionando. Desempenho limitado por ser rede ' + netType + '.'
                            : op.name + ' funcionando normalmente. Conexão estável.';
                _diagShowResult('✅', 'CONEXÃO ESTABELECIDA', msg, '');
            } else {
                _diagLog('⚠ ' + op.name + ' sem resposta real. Tentando próxima opção...', 'warn');
                if (window.Android) Android.stopTunnel();
                setTimeout(function() { _tryOption(options, idx + 1, weakSignal, is3G, signal, netType); }, 1000);
            }
        }, 8000);
    }, 2000);
}
    function saveConfig(){
        var val=document.getElementById('config-input').value.trim();
        if(val&&!val.startsWith('vless://')&&!val.includes('"outbounds"')){alert('Config não reconhecido.\nUse VLESS ou JSON com "outbounds".');return;}
        storageSave('netsmon_config',val);
        var gif=document.getElementById('gif-url-input').value.trim();
        storageSave('netsmon_bg',gif);storageSave('netsmon_bg_cache','');applyBackground(gif);
        alert('Configurações salvas!');handleAndroidBack();
    }
