<script>
    // =============================================================================
    // NEON CANVAS
    // =============================================================================
    (function() {
        var canvas = document.getElementById('neon-canvas');
        var ctx = canvas.getContext('2d');
        var STAR_COLORS = ['255,255,255','210,231,255','255,241,209','226,212,255'];
        var stars = [], NUM_STARS = 8;
        var _rafId = null, _running = true, _suspended = false, _neonWatchdog = null;
        // Limita a ~30 FPS — a animação não precisa de 60 FPS para parecer fluida
        // e isso já reduz à metade o trabalho de GPU/CPU em qualquer aparelho.
        var FRAME_INTERVAL = 33, _lastFrameTime = 0;
        // DPR capado em 1.5 — telas de alta densidade (3x, 4x) faziam o canvas
        // alocar texturas enormes sem ganho visual perceptível nesse tipo de efeito.
        var DPR = Math.min(window.devicePixelRatio || 1, 1.5);
        function resize() {
            var w = window.innerWidth, h = window.innerHeight;
            canvas.style.width = w + 'px';
            canvas.style.height = h + 'px';
            canvas.width = Math.round(w * DPR);
            canvas.height = Math.round(h * DPR);
            ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
        }
        // ── Estrela cadente ───────────────────────────────────────────────
        // Cabeça pequena e brilhante + cauda longa e fina que esmaece em
        // direção à origem do movimento.
        function createStar() {
            var w=window.innerWidth,h=window.innerHeight;
            var angle=Math.random()*Math.PI*2,speed=2.3+Math.random()*2.2;
            var color=STAR_COLORS[Math.floor(Math.random()*STAR_COLORS.length)];
            var alpha=0.55+Math.random()*0.35;
            var headRadius=0.9+Math.random()*1.1;     // cabeça pequena
            var tailLen=70+Math.floor(Math.random()*70); // cauda longa (pontos guardados)
            var side=Math.floor(Math.random()*4),extra=tailLen*speed,x,y;
            if(side===0){x=Math.random()*w;y=-extra;}else if(side===1){x=w+extra;y=Math.random()*h;}else if(side===2){x=Math.random()*w;y=h+extra;}else{x=-extra;y=Math.random()*h;}
            return{x:x,y:y,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,color:color,alpha:alpha,headRadius:headRadius,tailLen:tailLen,age:0,maxAge:140+Math.random()*180,trail:[]};
        }
        function init(){stars=[];for(var i=0;i<NUM_STARS;i++){var s=createStar();s.age=Math.random()*s.maxAge;stars.push(s);}}
        // ── Desenho sem shadowBlur ──────────────────────────────────────────
        // ctx.shadowBlur força o Skia/WebView a alocar uma surface offscreen
        // (textura EGL) a cada stroke. É a causa mais provável dos erros
        // "BAD ALLOC from gles_texture_egl_image_get_2d_template" no logcat.
        // Aqui o brilho da cauda vem de um gradiente linear (transparente →
        // opaco) e o brilho da cabeça vem de um gradiente radial — ambos são
        // apenas shaders, sem nenhuma alocação extra de GPU.
        function drawStar(s, ca){
            var trail=s.trail;
            if(trail.length<2) return;
            var first=trail[0], head=trail[trail.length-1];
            var tailGrad=ctx.createLinearGradient(first.x,first.y,head.x,head.y);
            tailGrad.addColorStop(0,'rgba('+s.color+',0)');
            tailGrad.addColorStop(0.7,'rgba('+s.color+','+(ca*0.25).toFixed(2)+')');
            tailGrad.addColorStop(1,'rgba('+s.color+','+ca.toFixed(2)+')');
            ctx.beginPath();
            ctx.moveTo(trail[0].x,trail[0].y);
            for(var j=1;j<trail.length;j++) ctx.lineTo(trail[j].x,trail[j].y);
            ctx.lineCap='round'; ctx.lineJoin='round';
            ctx.strokeStyle=tailGrad;
            ctx.lineWidth=Math.max(0.6,s.headRadius*0.55);
            ctx.stroke();
            // Halo suave da cabeça (gradiente radial, barato)
            var haloR=s.headRadius*4.5;
            var halo=ctx.createRadialGradient(head.x,head.y,0,head.x,head.y,haloR);
            halo.addColorStop(0,'rgba('+s.color+','+(ca*0.9).toFixed(2)+')');
            halo.addColorStop(0.45,'rgba('+s.color+','+(ca*0.28).toFixed(2)+')');
            halo.addColorStop(1,'rgba('+s.color+',0)');
            ctx.fillStyle=halo;
            ctx.beginPath();ctx.arc(head.x,head.y,haloR,0,Math.PI*2);ctx.fill();
            // Núcleo pequeno e nítido
            ctx.fillStyle='rgba('+s.color+','+ca.toFixed(2)+')';
            ctx.beginPath();ctx.arc(head.x,head.y,s.headRadius,0,Math.PI*2);ctx.fill();
        }
        function draw(ts){
            if(!_running){_rafId=null;return;}
            if(ts!==undefined && ts-_lastFrameTime<FRAME_INTERVAL){_rafId=requestAnimationFrame(draw);return;}
            _lastFrameTime=ts||0;
            ctx.clearRect(0,0,window.innerWidth,window.innerHeight);
            for(var i=0;i<stars.length;i++){
                var s=stars[i];s.x+=s.vx;s.y+=s.vy;s.age++;
                s.trail.push({x:s.x,y:s.y});if(s.trail.length>s.tailLen)s.trail.shift();
                var lr=s.age/s.maxAge,ff=lr<0.15?lr/0.15:lr>0.75?1-(lr-0.75)/0.25:1,ca=s.alpha*ff;
                drawStar(s,ca);
                var margin=s.tailLen*(Math.abs(s.vx)+Math.abs(s.vy));
                if(s.age>=s.maxAge||s.x<-margin||s.x>window.innerWidth+margin||s.y<-margin||s.y>window.innerHeight+margin)stars[i]=createStar();
            }
            _rafId=requestAnimationFrame(draw);
        }
        function pauseCanvas(){_running=false;if(_rafId!==null){cancelAnimationFrame(_rafId);_rafId=null;}}
        function resumeCanvas(){if(_suspended)return;if(!_running){_running=true;_rafId=requestAnimationFrame(draw);}}
        document.addEventListener('visibilitychange',function(){if(document.hidden)pauseCanvas();else resumeCanvas();});
        window.onWebViewPause=pauseCanvas;
        window.onWebViewResume=resumeCanvas;
        // ── Suspensão durante o handshake de conexão ─────────────────────
        // Chamado pelo próprio app (veja BOTÃO LIGAR/PARAR e onTunnelState)
        // para liberar 100% da GPU/CPU durante a criação da interface TUN e
        // o startCoreLoop do Xray — exatamente a janela mais sensível a
        // contenção de recursos do aparelho.
        window.setNeonSuspended=function(suspended){
            _suspended=!!suspended;
            if(_neonWatchdog){clearTimeout(_neonWatchdog);_neonWatchdog=null;}
            if(_suspended){
                pauseCanvas();
                // Rede de segurança: nunca fica suspenso por mais de 15s, mesmo
                // se onTunnelState não for chamado por algum motivo inesperado.
                _neonWatchdog=setTimeout(function(){window.setNeonSuspended(false);},15000);
            } else {
                resumeCanvas();
            }
        };
        window.addEventListener('resize',resize);
        resize();init();draw();
    })();

    // =============================================================================
    // Storage
    // =============================================================================
    function storageSave(k,v){if(window.Android&&Android.storageSave)Android.storageSave(k,v);else try{localStorage.setItem(k,v);}catch(e){}}
    function storageGet(k){if(window.Android&&Android.storageGet)return Android.storageGet(k);try{return localStorage.getItem(k);}catch(e){return null;}}

    // =============================================================================
    // Estado global
    // =============================================================================
    var isConnected=false, isSshConnecting=false;
    var timerInterval=null, connectTime=null, pingFallbackTimer=null;
    var uuidPattern=/^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$/;
    var allOperators=[], currentCategory=null, selectedOpName=null;
    var sshPopupMode='connect', sshPendingOperator=null;
    var routingActive=false, routingProxyAddr='';

    // Estado proxy share (transmissor)
    var proxyShareActive = false;
    var proxyShareAddresses = [];
    var proxySharePort = 5578;

    // Estado receptor
    // _receiveProxyActive removido junto com o botão de receber (ver
    // instruções do app — só o botão de enviar compartilhamento existe agora)

    // =============================================================================
    // Back handler
    // =============================================================================
    window.handleAndroidBack = function() {
        if(document.getElementById('log-modal').classList.contains('open')){closeLogModal();return;}
        if(document.getElementById('qr-popup-overlay').classList.contains('open')){closeQrPopupSafe();return;}
        if(document.getElementById('routing-popup-overlay').classList.contains('open')){closeRoutingPopup();return;}
        if(document.getElementById('ssh-popup-overlay').classList.contains('open')){closeSshPopup();return;}
        if(document.getElementById('operator-modal').classList.contains('open')){closeOperatorModal();return;}
        var active=document.querySelector('section.active');
        if(active&&active.id!=='home'){showPage('home');return;}
    };

    // =============================================================================
    // Callback: botão PARAR da notificação de hotspot
    // =============================================================================
    window.onProxyShareStopped = function() {
        proxyShareActive = false;
        proxyShareAddresses = [];
        document.getElementById('qr-share-btn').classList.remove('share-active');
        if(document.getElementById('qr-popup-overlay').classList.contains('open')) {
